{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "tab-window-*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-close",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "deny": [
        "/dev",
        "/dev/**",
        "/etc",
        "/etc/**",
        "/private/dev",
        "/private/dev/**",
        "/private/etc",
        "/private/etc/**",
        "$HOME/.ssh",
        "$HOME/.ssh/**",
        "$HOME/.aws",
        "$HOME/.aws/**",
        "$HOME/.gnupg",
        "$HOME/.gnupg/**",
        "$HOME/.kube",
        "$HOME/.kube/**"
      ]
    },
    "process:allow-restart",
    "opener:default",
    "updater:default"
  ]
}
